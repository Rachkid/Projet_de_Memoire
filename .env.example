# Copier ce fichier en ".env" et adapter les valeurs avant de démarrer le projet.

# Identifiants de la base de données PostgreSQL
POSTGRES_USER=objets_trouves_user
POSTGRES_PASSWORD=change_moi
POSTGRES_DB=objets_trouves_db

# URL complète utilisée par l'application pour se connecter à la base
# (le mot "db" correspond au nom du service PostgreSQL dans docker-compose.yml)
DATABASE_URL=postgresql://objets_trouves_user:change_moi@db:5432/objets_trouves_db

# Clé secrète utilisée pour signer les jetons de connexion (à générer aléatoirement, 32 caractères minimum).
# Pour en générer une : python -c "import secrets; print(secrets.token_hex(32))"
# Si cette clé fuite, n'importe qui peut fabriquer de faux jetons : ne la partagez jamais, ne la mettez jamais sur GitHub.
SECRET_KEY=change_moi_aussi_avec_une_valeur_aleatoire_longue

# Adresse publique du site, facultative (sans « / » final). Utilisée par le code QR de l'écran d'affichage.
# À renseigner quand le site est en ligne, par exemple : ADRESSE_PUBLIQUE=https://objets.iat.ne
ADRESSE_PUBLIQUE=

# Courriels (facultatif). Sans rien ici, docker-compose utilise MailHog : les courriels sont captés et
# lisibles sur http://localhost:8025, rien ne part à l'extérieur (idéal pour les essais et la démonstration).
# En production, décommenter et renseigner le serveur de courrier du client :
# SMTP_HOST=smtp.exemple.ne
# SMTP_PORT=587
# SMTP_UTILISATEUR=objets@exemple.ne
# SMTP_MOT_DE_PASSE=...
# SMTP_STARTTLS=true
# COURRIEL_EXPEDITEUR=Objets trouvés <objets@exemple.ne>

# --- Sécurité (étape 16) : valeurs par défaut sensées, à ne changer que si besoin ---
# Connexion : au plus 5 échecs par adresse + identifiant sur 5 minutes, 20 échecs par adresse.
# LIMITE_CONNEXION_ESSAIS=5
# LIMITE_CONNEXION_PAR_ADRESSE=20
# LIMITE_CONNEXION_MINUTES=5
# Formulaires publics (déclaration de perte) : 20 requêtes par adresse sur 10 minutes.
# LIMITE_DECLARATIONS=20
# LIMITE_DECLARATIONS_MINUTES=10
# À mettre à true UNIQUEMENT derrière un relais de confiance (Nginx, Caddy) qui ajoute X-Forwarded-For.
# PROXY_DE_CONFIANCE=false
# Archivage automatique des objets au-delà du délai de conservation de leur organisation.
# ARCHIVAGE_AUTO=true
# ARCHIVAGE_INTERVALLE_HEURES=6
